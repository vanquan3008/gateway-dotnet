{
  "Authentication": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Core.Gateway.Api": "Information",
      "Yarp.ReverseProxy": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      },
      "FormatterName": "json"
    }
  },
  "Observability": {
    "OtlpExporterEnabled": true
  }
}
