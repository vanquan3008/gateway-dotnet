{
  "Gateway": {
    "RoutesFile": "Configuration/reverseproxy.json"
  },
  "Authentication": {
    "Enabled": false,
    "Jwt": {
      "Providers": {},
      "RequireHttpsMetadata": true,
      "ClockSkewSeconds": 30,
      "BackchannelTimeoutMilliseconds": 5000
    },
    "ApiKeys": {
      "Enabled": false,
      "HeaderName": "X-Api-Key",
      "Clients": {}
    },
    "Signature": {
      "Enabled": false,
      "ClientIdHeader": "X-Client-Id",
      "SignatureHeader": "X-Signature",
      "TimestampHeader": "X-Timestamp",
      "MaxClockSkewSeconds": 300,
      "MaxBodyBytes": 131072,
      "RejectReplays": true,
      "Algorithm": "RS256",
      "Clients": {}
    }
  },
  "Headers": {
    "ClaimsToHeaders": {
      "X-User-Id": "sub",
      "X-Tenant-Id": "tenant_id",
      "X-Auth-Issuer": "iss"
    }
  },
  "Cors": {
    "Enabled": false,
    "AllowedOrigins": [],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE"
    ],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type",
      "X-Correlation-ID"
    ]
  },
  "GatewaySecurity": {
    "ForwardLimit": 1,
    "MaxRequestBodySizeBytes": 10485760,
    "AllowedHosts": [
      "*"
    ],
    "KnownProxies": [],
    "KnownNetworks": [],
    "AllowedForwardedHosts": []
  },
  "Redis": {
    "KeyPrefix": "gateway",
    "TimeoutMilliseconds": 250,
    "ConnectTimeoutMilliseconds": 2000,
    "FailureCooldownSeconds": 5
  },
  "RateLimiting": {
    "Enabled": true,
    "Local": {
      "Enabled": true,
      "Instance": {
        "PermitLimit": 1000,
        "WindowSeconds": 1,
        "QueueLimit": 0
      },
      "Service": {
        "PermitLimit": 600,
        "WindowSeconds": 1,
        "QueueLimit": 0
      },
      "Anonymous": {
        "PermitLimit": 500,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "InstanceConcurrencyLimit": 1024,
      "ServiceConcurrencyLimit": 256
    },
    "Distributed": {
      "Enabled": false,
      "UserIdClaim": "sub",
      "TenantIdClaim": "tenant_id",
      "ApiKeyIdClaim": "api_key_id",
      "Authenticated": {
        "PermitLimit": 300,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Anonymous": {
        "PermitLimit": 60,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Fallback": {
        "UseLocalFallbackWhenStoreUnavailable": true,
        "LocalRatio": 0.5,
        "AutoScaleRatio": true,
        "HeartbeatSeconds": 5
      }
    },
    "Policies": {}
  },
  "Resilience": {
    "RequestTimeoutSeconds": 30,
    "TimeoutPolicies": {},
    "RetryAttempts": 1,
    "ConnectTimeoutSeconds": 5,
    "ActivityTimeoutSeconds": 20,
    "PooledConnectionLifetimeSeconds": 60,
    "BackendHealthCheckEnabled": true,
    "BackendHealthDetectionWindowSeconds": 10,
    "BackendHealthReactivationSeconds": 11,
    "BackendHealthMinimumRequestCount": 10,
    "BackendHealthFailureRate": 0.3,
    "FailWhenAllDestinationsUnhealthy": true
  },
  "HealthChecks": {
    "LivenessPath": "/health/live",
    "ReadinessPath": "/health/ready"
  },
  "Observability": {
    "ServiceName": "Core.Gateway.Api",
    "OtlpExporterEnabled": false,
    "OtlpTimeoutMilliseconds": 1000
  },
  "Logging": {
    "Console": {
      "QueueFullMode": "DropWrite",
      "MaxQueueLength": 1024
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  }
}
