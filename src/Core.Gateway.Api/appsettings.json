{
  "Gateway": {
    "RoutesFile": "Configuration/reverseproxy.json"
  },
  "Authentication": {
    "Enabled": false,
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30,
    "BackchannelTimeoutMilliseconds": 5000
  },
  "Cors": {
    "Enabled": false,
    "AllowedOrigins": [],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE"
    ],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type",
      "X-Correlation-ID"
    ]
  },
  "GatewaySecurity": {
    "ForwardLimit": 1,
    "MaxRequestBodySizeBytes": 10485760,
    "AllowedHosts": [
      "*"
    ],
    "KnownProxies": [],
    "KnownNetworks": [],
    "AllowedForwardedHosts": []
  },
  "RateLimiting": {
    "Enabled": true,
    "Local": {
      "Enabled": true,
      "Instance": {
        "PermitLimit": 5000,
        "WindowSeconds": 1,
        "QueueLimit": 0
      },
      "Service": {
        "PermitLimit": 2000,
        "WindowSeconds": 1,
        "QueueLimit": 0
      },
      "Anonymous": {
        "PermitLimit": 500,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "InstanceConcurrencyLimit": 1024,
      "ServiceConcurrencyLimit": 256
    },
    "Distributed": {
      "Enabled": false,
      "UserIdClaim": "sub",
      "TenantIdClaim": "tenant_id",
      "ApiKeyIdClaim": "api_key_id",
      "Authenticated": {
        "PermitLimit": 300,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Anonymous": {
        "PermitLimit": 60,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "KeyPrefix": "gateway:ratelimit",
      "FailOpen": true,
      "TimeoutMilliseconds": 250,
      "ConnectTimeoutMilliseconds": 2000,
      "FailureCooldownSeconds": 5
    }
  },
  "Resilience": {
    "RequestTimeoutSeconds": 30,
    "ConnectTimeoutSeconds": 5,
    "ActivityTimeoutSeconds": 20,
    "PooledConnectionLifetimeSeconds": 60,
    "BackendHealthCheckEnabled": true,
    "BackendHealthDetectionWindowSeconds": 10,
    "BackendHealthReactivationSeconds": 11,
    "BackendHealthMinimumRequestCount": 10,
    "BackendHealthFailureRate": 0.3,
    "FailWhenAllDestinationsUnhealthy": true
  },
  "HealthChecks": {
    "LivenessPath": "/health/live",
    "ReadinessPath": "/health/ready"
  },
  "Observability": {
    "ServiceName": "Core.Gateway.Api",
    "OtlpExporterEnabled": false,
    "OtlpTimeoutMilliseconds": 1000
  },
  "Logging": {
    "Console": {
      "QueueFullMode": "DropWrite",
      "MaxQueueLength": 1024
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  }
}
