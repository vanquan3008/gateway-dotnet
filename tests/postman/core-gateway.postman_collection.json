                  "const authOn = pm.variables.get('authEnabled') === 'true';",
                  "if (authOn) {",
                  "    pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "    pm.test('Có WWW-Authenticate: Bearer', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer'));",
                  "    pm.test('Body có correlationId', () => pm.expect(pm.response.json().correlationId).to.eql(pm.response.headers.get('X-Correlation-ID')));",
                  "} else {",
                  "    pm.test('Xác thực tắt: 200 OK', () => pm.response.to.have.status(200));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
