      "name": "2. Proxy routes",
      "item": [
        {
          "name": "GET /api/users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Body là mảng JSON không rỗng', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(body[0]).to.have.property('id');",
                  "});",
                  "",
                  "pm.collectionVariables.set('usersBody', pm.response.text());",
                  "",
                  "pm.test('Có header X-Correlation-ID', () => pm.expect(pm.response.headers.has('X-Correlation-ID')).to.be.true);",
                  "pm.test('Không lộ Server / X-Powered-By', () => {",
                  "    pm.expect(pm.response.headers.has('Server')).to.be.false;",
                  "    pm.expect(pm.response.headers.has('X-Powered-By')).to.be.false;",
                  "});",
                  "pm.test('Có security headers', () => {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
                  "    pm.expect(pm.response.headers.get('Referrer-Policy')).to.eql('no-referrer');",
                  "});"
                ]
              }
            }
