    {
      "name": "3. Correlation id và headers",
      "item": [
        {
          "name": "Correlation id hợp lệ được giữ nguyên",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('cid', 'postman-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Gateway trả lại đúng correlation id đã gửi', () => {",
                  "    pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(pm.variables.get('cid'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{cid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Id gồm chữ, số, - _ . và tối đa 64 ký tự thì được giữ."
          },
          "response": []
        },
        {
          "name": "Correlation id không hợp lệ bị thay",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Id có khoảng trắng bị thay bằng id mới hợp lệ', () => {",
                  "    const id = pm.response.headers.get('X-Correlation-ID');",
                  "    pm.expect(id).to.not.eql('id khong hop le');",
                  "    pm.expect(id).to.match(/^[A-Za-z0-9._-]{1,64}$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "id khong hop le"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Giá trị chứa khoảng trắng bị bỏ và gateway sinh id mới."
          },
          "response": []
        },
        {
          "name": "Header danh tính giả không được tin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const authOn = pm.variables.get('authEnabled') === 'true';",
                  "pm.test('Không bị từ chối vì header giả', () => pm.expect(pm.response.code).to.be.oneOf(authOn ? [401] : [200]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "forged-user"
              },
              {
                "key": "X-Tenant-Id",
                "value": "forged-tenant"
              },
              {
                "key": "X-Auth-Issuer",
                "value": "https://forged.test"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Gateway xóa các header X-User-Id, X-Tenant-Id, X-Auth-Issuer do client gửi; giá trị chỉ lấy từ claim đã xác thực. Mock API không in lại header nên request này chỉ xác nhận không gây lỗi. Test chi tiết nằm trong test tích hợp."
          },
          "response": []
        }
      ],
      "description": "Correlation id và việc gateway làm sạch header."
    },
