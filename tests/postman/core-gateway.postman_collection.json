        {
          "name": "JWT sai",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const authOn = pm.variables.get('authEnabled') === 'true';",
                  "(authOn ? pm.test : pm.test.skip)('401 với token rác', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer abc.def.ghi"
              }
