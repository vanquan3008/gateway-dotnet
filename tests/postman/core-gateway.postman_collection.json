        {
          "name": "Burst tới khi bị 429",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const max = Number(pm.variables.get('burstMax') || 0);",
                  "const sent = Number(pm.collectionVariables.get('burstCount') || 0) + 1;",
                  "pm.collectionVariables.set('burstCount', String(sent));",
                  "const next = (name) => (pm.execution && pm.execution.setNextRequest ? pm.execution.setNextRequest(name) : postman.setNextRequest(name));",
                  "",
                  "pm.test('200 hoặc 429', () => pm.expect(pm.response.code).to.be.oneOf([200, 429]));",
                  "if (pm.response.code === 429) {",
                  "    pm.test('429 có Retry-After hợp lệ', () => {",
                  "        const retry = Number(pm.response.headers.get('Retry-After'));",
                  "        pm.expect(retry).to.be.at.least(1);",
                  "        pm.collectionVariables.set('retryAfter', String(retry));",
                  "    });",
                  "    pm.test('429 là problem+json có correlationId', () => {",
                  "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "        const body = pm.response.json();",
                  "        pm.expect(body.title).to.eql('Too Many Requests');",
                  "        pm.expect(body.correlationId).to.eql(pm.response.headers.get('X-Correlation-ID'));",
                  "    });",
                  "    if (pm.variables.get('sharedQuota') === 'true') {",
                  "        pm.test('X-RateLimit-Remaining = 0 khi bị chặn bởi quota chung', () => {",
                  "            if (pm.response.headers.has('X-RateLimit-Remaining')) pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.eql('0');",
                  "        });",
                  "    }",
                  "    pm.collectionVariables.set('got429', 'true');",
                  "    next('Sau khi chờ Retry-After thì được nhận lại');",
                  "} else if (max > 0 && sent < max) {",
                  "    next('Burst tới khi bị 429');",
                  "} else if (max > 0) {",
                  "    pm.test(`Phải gặp 429 trong ${max} request`, () => pm.expect.fail(`Đã gửi ${sent} request mà chưa bị giới hạn`));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
