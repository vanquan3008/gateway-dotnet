      "name": "5. Rate limit",
      "item": [
        {
          "name": "Header X-RateLimit-* trên request thành công",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sharedOn = pm.variables.get('sharedQuota') === 'true';",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "(sharedOn ? pm.test : pm.test.skip)('Có đủ X-RateLimit-Limit / Remaining / Reset', () => {",
                  "    ['X-RateLimit-Limit', 'X-RateLimit-Remaining', 'X-RateLimit-Reset'].forEach(h => pm.expect(pm.response.headers.has(h), h).to.be.true);",
                  "    const limit = Number(pm.response.headers.get('X-RateLimit-Limit'));",
                  "    const remaining = Number(pm.response.headers.get('X-RateLimit-Remaining'));",
                  "    pm.expect(limit).to.be.above(0);",
                  "    pm.expect(remaining).to.be.within(0, limit);",
                  "    pm.expect(Number(pm.response.headers.get('X-RateLimit-Reset'))).to.be.at.least(1);",
                  "    pm.collectionVariables.set('lastRemaining', String(remaining));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
