GatewaySecurity__AllowedHosts__0=gateway.example.com
GatewaySecurity__KnownNetworks__0=192.0.2.0/24
GatewaySecurity__AllowedForwardedHosts__0=gateway.example.com
Observability__OtlpExporterEnabled=true
Observability__OtlpEndpoint=http://otel-collector.observability.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
RateLimiting__Local__Enabled=true
RateLimiting__Local__Instance__PermitLimit=1000
RateLimiting__Local__Instance__WindowSeconds=1
RateLimiting__Local__Service__PermitLimit=600
RateLimiting__Local__Service__WindowSeconds=1
RateLimiting__Local__InstanceConcurrencyLimit=1024
RateLimiting__Local__ServiceConcurrencyLimit=256
# Per pod and per IP, only a flood shield in front of Redis: 5x the shared anonymous quota (60/min), so normal clients never hit it.
RateLimiting__Local__Anonymous__PermitLimit=300
RateLimiting__Local__Anonymous__WindowSeconds=60
RateLimiting__Distributed__Enabled=true
RateLimiting__Distributed__Authenticated__PermitLimit=300
RateLimiting__Distributed__Anonymous__PermitLimit=60
Redis__KeyPrefix=core-gateway:production
RateLimiting__Distributed__Fallback__UseLocalFallbackWhenStoreUnavailable=true
# 1 / HPA minReplicas: only used by a pod that starts while Redis is down, before it has counted its peers.
RateLimiting__Distributed__Fallback__LocalRatio=0.34
Resilience__RequestTimeoutSeconds=30
Resilience__ConnectTimeoutSeconds=5
Resilience__ActivityTimeoutSeconds=20
Resilience__PooledConnectionLifetimeSeconds=60
Resilience__BackendHealthCheckEnabled=true
Resilience__BackendHealthDetectionWindowSeconds=10
Resilience__BackendHealthReactivationSeconds=11
Resilience__BackendHealthMinimumRequestCount=10
Resilience__BackendHealthFailureRate=0.3
Resilience__FailWhenAllDestinationsUnhealthy=true
